<?xml version="1.0" encoding="utf-8"?>
<Mod id="bz-zoom" version="1.0.0" xmlns="ModInfo">
    <Properties>
        <Name>LOC_MOD_BZ_ZOOM_NAME</Name>
        <Version>1.0.0</Version>
        <Description>LOC_MOD_BZ_ZOOM_DESCRIPTION</Description>
        <Authors>beezany</Authors>
        <Package>Mod</Package>
        <AffectsSavedGames>0</AffectsSavedGames>
        <bzIcon>blp:action_lookout</bzIcon>
        <bzIconGlow>#6dcef7</bzIconGlow>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>
    <References>
    </References>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet/>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="bz-zoom-always" scope="game" criteria="always">
            <Properties>
                <LoadOrder>50</LoadOrder>
            </Properties>
            <Actions>
                <UIScripts>
                    <Item>ui/camera/bz-camera-controller.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModInfoText.xml</File>
    </LocalizedText>
</Mod>
